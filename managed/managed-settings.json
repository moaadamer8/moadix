{
  "requiredMinimumVersion": "2.1.295",
  "extraKnownMarketplaces": {
    "moadix": {
      "source": {
        "source": "github",
        "repo": "__MARKETPLACE_REPO__"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "__MARKETPLACE_REPO__"
    },
    {
      "source": "github",
      "repo": "anthropics/claude-plugins-official"
    }
  ],
  "enabledPlugins": {
    "moadix@moadix": true,
    "claude-security@claude-plugins-official": true
  },
  "disableSideloadFlags": true,
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "crossSessionInbound": "refuse",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I '__MOADIX_HOME__/gate/hook.py' prompt",
            "timeout": 90,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I '__MOADIX_HOME__/gate/hook.py' stop",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -I '__MOADIX_HOME__/gate/hook.py' pretool",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "CronCreate",
      "CronDelete",
      "ScheduleWakeup",
      "SendMessage",
      "ListAgents",
      "RemoteTrigger",
      "Read(~/.claude/projects/**)",
      "Edit(~/.claude/**)",
      "Edit(/__CC_DIR__/**)",
      "Bash(sudo *)",
      "Bash(claude *)",
      "Bash(security *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "MOADIX_PIN": "__PIN__"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "docker *",
      "npx playwright *",
      "playwright *"
    ],
    "filesystem": {
      "denyWrite": [
        "~/**/.sdlc",
        "~/**/.sdlc/**",
        "~/**/.claude",
        "~/**/.claude/**",
        "~/.claude",
        "~/.claude.json",
        "__CC_DIR__",
        "~/Library/Keychains"
      ],
      "denyRead": [
        "~/.claude/projects"
      ],
      "allowWrite": [
        "~/.npm",
        "~/Library/Caches/ms-playwright",
        "~/Library/Caches/pip",
        "~/.cache",
        "~/Library/Caches/trivy",
        "~/.semgrep"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "storage.googleapis.com",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "api.osv.dev",
        "api.deps.dev",
        "osv-vulnerabilities.storage.googleapis.com",
        "mirror.gcr.io",
        "ghcr.io",
        "pkg-containers.githubusercontent.com",
        "api.github.com"
      ]
    }
  }
}
